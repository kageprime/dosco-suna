{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kortix-ai/suna/blob/dev/apps/capture/schemas/status.schema.json",
  "title": "status.json",
  "description": "<prefix>/<device_id>/status.json, plaintext, written every 60 s. A reader shows the device offline when reportedAtMs is older than 120 s.",
  "type": "object",
  "required": [
    "recording",
    "reason",
    "missingPermissions",
    "pausedUntilMs",
    "audio",
    "sync",
    "lastFrameMs",
    "appVersion",
    "actionsRecording",
    "reportedAtMs"
  ],
  "properties": {
    "recording": {
      "enum": [
        "recording",
        "paused",
        "permission_missing",
        "not_recording"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastError": {
      "description": "While reason is `error`: the recorder's last capture error, at most 300 characters. Absent or null otherwise and from app versions before 0.14.20.",
      "type": [
        "string",
        "null"
      ]
    },
    "missingPermissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pausedUntilMs": {
      "type": [
        "integer",
        "null"
      ]
    },
    "audio": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sync": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "ok",
            "queued",
            "error",
            "off"
          ]
        },
        "pending": {
          "type": "integer"
        },
        "errorClass": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastUploadMs": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "lastFrameMs": {
      "type": [
        "integer",
        "null"
      ]
    },
    "appVersion": {
      "type": "string"
    },
    "actionsRecording": {
      "type": "boolean"
    },
    "capture": {
      "type": "object",
      "description": "The screen capture rate and size in force: the account policy's recording.interval_ms/max_height, else the device's own settings.",
      "required": [
        "intervalMs",
        "maxHeight"
      ],
      "properties": {
        "intervalMs": {
          "type": "integer",
          "minimum": 500
        },
        "maxHeight": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "policy": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "type": "string"
            },
            "updatedAtMs": {
              "type": "integer"
            },
            "fetchedAtMs": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "reportedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "displays": {
      "type": "array",
      "description": "Every connected display, the focused one first, with the time of its last frame (a static display writes a keep-alive frame every 30 s).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "lastFrameMs"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "main": {
            "type": "boolean"
          },
          "focused": {
            "type": "boolean"
          },
          "lastFrameMs": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "host": {
      "type": "object",
      "description": "The computer. awakeSinceMs: when it last woke from sleep, or when the app started (a gap over 120 s between sync ticks counts as a sleep). A reader counts \"not recording\" time from this moment, never across a sleep.",
      "required": [
        "awakeSinceMs"
      ],
      "properties": {
        "awakeSinceMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resources": {
      "description": "What Kortix Capture itself costs this computer: the processes whose executable starts with kortix-capture or kortix-backend (or the macOS app Kortix Capture) that this user can read. Sampled once a minute; the report covers the last 10 samples. CPU is a percentage of one core (100 = one core busy; it can pass 100 on several cores). Memory is the working set (Windows) or resident size (macOS, Linux). Null during the first minute after start, and absent from app versions without it.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "windowMs",
            "samples",
            "cpuPercentAvg",
            "cpuPercentPeak",
            "memoryBytes",
            "memoryBytesPeak",
            "processCount",
            "processes",
            "sampledAtMs"
          ],
          "properties": {
            "windowMs": {
              "type": "integer",
              "minimum": 1,
              "description": "The time the samples cover, about 600000."
            },
            "samples": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "description": "One-minute intervals in the window."
            },
            "cpuPercentAvg": {
              "type": "number",
              "minimum": 0,
              "description": "CPU over the whole window, percent of one core."
            },
            "cpuPercentPeak": {
              "type": "number",
              "minimum": 0,
              "description": "The busiest interval of the window, percent of one core."
            },
            "memoryBytes": {
              "type": "integer",
              "minimum": 0,
              "description": "All processes together at the last sample."
            },
            "memoryBytesPeak": {
              "type": "integer",
              "minimum": 0,
              "description": "The highest total of the window."
            },
            "processCount": {
              "type": "integer",
              "minimum": 0,
              "description": "Processes at the last sample."
            },
            "processes": {
              "type": "array",
              "maxItems": 16,
              "description": "One entry per executable name, the most CPU first.",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "count",
                  "cpuPercentAvg",
                  "memoryBytes"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Lower case, no .exe: kortix-capture, kortix-capture-engine, kortix-backend, kortix capture."
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Processes with this name at the last sample (0: all exited)."
                  },
                  "cpuPercentAvg": {
                    "type": "number",
                    "minimum": 0
                  },
                  "memoryBytes": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "sampledAtMs": {
              "type": "integer",
              "minimum": 0
            },
            "readMicros": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "Wall time of the last process table read, in microseconds: what this report costs."
            }
          }
        }
      ]
    },
    "update": {
      "description": "The self-update state from the machine service (update.json), or null on a computer without one.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "current",
                "behind",
                "updating",
                "failed",
                "disabled"
              ]
            },
            "installed": {
              "type": "string"
            },
            "channel": {
              "type": "string"
            },
            "latest": {
              "type": [
                "string",
                "null"
              ]
            },
            "lastCheckMs": {
              "type": [
                "integer",
                "null"
              ]
            },
            "lastCheck": {
              "type": [
                "string",
                "null"
              ],
              "description": "What the last check did, in a sentence."
            },
            "updatingTo": {
              "type": [
                "string",
                "null"
              ]
            },
            "lastResult": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "at_ms",
                    "from",
                    "to",
                    "outcome"
                  ],
                  "properties": {
                    "at_ms": {
                      "type": "integer"
                    },
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    },
                    "outcome": {
                      "enum": [
                        "updated",
                        "rolled_back",
                        "failed",
                        "install_failed"
                      ]
                    },
                    "detail": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Why it failed: the installer error, or the health probe's reason (`session 2: no_new_frame (…)`)."
                    }
                  }
                }
              ]
            },
            "badVersions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "skipped": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "version"
                ],
                "properties": {
                  "version": {
                    "type": "string"
                  },
                  "failedAtMs": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "retryAtMs": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
