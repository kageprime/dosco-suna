{
  "expo": {
    "name": "Dosco",
    "slug": "dosco",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/AppIcon-Light.png",
    "scheme": "dosco",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.dosco.app",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:dosco.live",
        "webcredentials:dosco.live"
      ],
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSCameraUsageDescription": "Dosco needs camera access so you can attach photos to a session.",
        "NSPhotoLibraryUsageDescription": "Dosco needs access to your photo library so you can attach images to a session.",
        "NSSpeechRecognitionUsageDescription": "Dosco turns your speech into text when you dictate a message.",
        "NSMicrophoneUsageDescription": "Dosco uses the microphone when you dictate a message and when you record a video to attach to a session.",
        "NSUserTrackingUsageDescription": "Dosco uses analytics to improve your experience and understand how features are used. For example, we track which AI features are most helpful so we can make the app better for everyone."
      },
      "appleTeamId": "T8G9J33433",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F0F0E9"
      },
      "package": "com.dosco.application",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "dosco.live",
              "pathPrefix": "/auth/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "dosco.live",
              "pathPrefix": "/share"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "sounds": [
            "./assets/sounds/kortix/kortix_complete.wav",
            "./assets/sounds/kortix/kortix_attention.wav",
            "./assets/sounds/kortix/kortix_error.wav"
          ]
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "backgroundColor": "#ffffff",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Dosco needs camera access so you can attach photos to a session.",
          "photosPermission": "Dosco needs access to your photo library so you can attach images to a session.",
          "microphonePermission": "Dosco uses the microphone when you dictate a message and when you record a video to attach to a session."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Dosco uses the microphone when you dictate a message and when you record a video to attach to a session.",
          "speechRecognitionPermission": "Dosco turns your speech into text when you dictate a message.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as",
            "com.google.android.tts",
            "com.samsung.android.bixby.agent"
          ]
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Dosco uses analytics to improve your experience and understand how features are used. For example, we track which AI features are most helpful so we can make the app better for everyone."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "ka9es-team",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/2e700259-ff47-4127-9fcf-f9a435746a13",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "2e700259-ff47-4127-9fcf-f9a435746a13"
      }
    }
  }
}
