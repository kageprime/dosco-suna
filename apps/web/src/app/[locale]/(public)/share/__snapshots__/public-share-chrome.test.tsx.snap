exports[`public share chrome the artifact page renders the bar, the sheet and the sandboxed iframe 1`] = `"<main class="bg-card text-foreground flex h-dvh flex-col"><header class="flex h-12 shrink-0 items-center gap-3 pr-3 pl-4"><div class="flex min-w-0 flex-1 items-center gap-2.5"><svg width="30" height="25" viewBox="0 0 30 25" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0" style="width:16px;height:16px"><path d="M25.56 24.916H29.83C29.83 19.63 26.94 15 22.62 12.46C26.94 9.91 29.83 5.29 29.83 0H25.56C25.56 5 21.89 9.19 17.07 10.17V0H12.8V10.17C7.95 9.2 4.3 5.02 4.3 0H0.04C0.04 5.29 2.93 9.91 7.25 12.46C2.93 15 0.04 19.63 0.04 24.916H4.3C4.3 19.9 7.95 15.71 12.8 14.75V24.92H17.07V14.75C21.91 15.71 25.56 19.9 25.56 24.916Z" fill="currentColor"></path></svg><h1 class="truncate text-sm font-medium">Synthetic artifact</h1></div><a data-slot="button" class="flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-[color,background-color,border-color,box-shadow,opacity,scale,translate] disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive text-center shadow-none data-[state=open]:ring-0 focus-visible:outline-none focus-visible:ring-kortix-base focus-visible:ring-[0.6px] bg-secondary hover:bg-secondary/90 text-foreground h-8 gap-1.5 px-3 has-[&gt;svg]:px-2.5" href="/">tryKortix</a></header><section class="bg-background border-border relative min-h-0 flex-1 overflow-hidden rounded-t-md border-x border-t"><iframe src="https://cdn.example.test/synthetic.html" title="Synthetic artifact" class="h-full w-full border-0 bg-white" sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox allow-modals allow-downloads" allow="fullscreen; clipboard-write; autoplay; encrypted