exports[`hero characterization solutions hub renders all role links 1`] = `"<div class="bg-background relative"><section class="relative isolate flex min-h-[80dvh] w-full flex-row items-start justify-between overflow-visible border-b pt-32 pb-12 sm:pt-36 xl:h-[80dvh]"><div class="pointer-events-none absolute inset-0 z-0 origin-bottom mask-t-from-50% mask-t-to-80%" aria-hidden="true"><div class="pointer-events-none absolute inset-0 overflow-hidden opacity-10" aria-hidden="true"></div></div><div class="relative mx-auto grid h-full w-full max-w-7xl grid-cols-1 place-items-center items-center gap-6 xl:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]"><div class="relative z-10 mx-auto flex aspect-auto w-full flex-col items-start justify-center gap-6 px-6 pt-6 pb-8 sm:px-8 sm:pt-8 sm:pb-16 xl:aspect-square" style="opacity:0;filter:blur(8px);transform:translateY(30px)"><span class="text-muted-foreground font-mono text-[0.75rem] leading-none font-normal uppercase select-none" data-text="true">Solutions</span><h1 class="text-foreground max-w-4xl text-4xl font-medium tracking-tight text-balance sm:text-5xl lg:text-6xl">One platform. Eight teams with completely different work.</h1><p class="text-muted-foreground max-w-2xl text-lg leading-relaxed">The same project, the same connectors, the same memory — and eight different jobs underneath. Each team writes the skills for its own work, and nobody stands up a second system to do it.</p><div class="kx-hero-text flex w-full shrink-0 flex-wrap items-center gap-2 [--kx-enter:210ms] sm:w-auto sm:gap-3"><a data-slot="button" class="group/button inline-flex cursor-pointer items-center justify-center gap-2 font-medium whitespace-nowrap transition-transform focus-visible:ring-1 focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none text-center [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 [&amp;_svg]:shrink-0 [&amp;_svg]:drop-shadow-sm dark:shadow-md shadow-black/15 border-[0.5px] border-background/10 bg-foreground text-background hover:bg-foreground/90 focus-visible:ring-foreground dark:border-transparent h-10 px-4 text-md rounded-[calc(var(--radius-md)-0.4px)] flex-1 active:scale-[0.97] sm:flex-none" href="/auth">Get started</a><a data-slot="button" class="group/button inline-flex cursor-pointer items-center justify-center font-medium whitespace-nowrap transition-transform focus-visible:ring-1 focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none text-center [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 [&amp;_svg]:shrink-0 [&amp;_svg]:drop-shadow-sm dark:shadow-md shadow-black/15 bg-transparent text-muted-foreground hover:bg-secondary hover:text-foreground h-10 px-4 text-md rounded-[calc(var(--radius-md)-0.4px)] group/cta flex-1 gap-1.5 active:scale-[0.97] sm:flex-none" href="/contact">Talk to us<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="size-4 transition-transform duration-200 ease-out group-hover/cta:translate-x-0.5" aria-hidden="true"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"></path></svg></a></div></div><div class="relative z-20 mx-auto flex w-full items-center justify-center overflow-visible px-6 xl:self-stretch"><div class="flex w-full items-center justify-center" role="img" aria-label="The eight teams this platform serves, and the object each one gets back."><div class="relative h-[24rem] w-full max-w-[38rem] overflow-hidden sm:h-[27rem]"><span class="bg-border absolute inset-y-0 left-[3%] w-px mask-y-from-82% mask-y-to-100%" aria-hidden="true" style="opacity:0;transform:scaleY(0)"></span><ul class="absolute inset-0 flex flex-col justify-center mask-y-from-88% mask-y-to-100%"><li class="flex items-baseline gap-4 py-[0.42rem]" style="padding-left:6%;opacity:0;transform:translateX(-12px)"><span class="text-foreground text-[22px] leading-none font-medium tracking-tight sm:text-[26px]">Sales</span><span class="bg-border/70 hidden h-px flex-1 sm:block"></span><span class="text-muted-foreground/45 shrink-0 font-mono text-[10.5px] whitespace-nowrap">a table</span></li><li class="flex items-baseline gap-4 py-[0.42rem]" style="padding-left:7.6%;opacity:0;transform:translateX(-12px)"><span class="text-foreground text-[22px] leading-none font-medium tracking-tight sm:text-[26px]">Marketing</span><span class="bg-border/70 hidden h-px flex-1 sm:block"></span><span class="text-muted-foreground/45 shrink-0 font-mono text-[10.5px] whitespace-nowrap">a document</span></li><li class="flex items-baseline gap-4 py-[0.42rem]" style="padding-left:9.2%;opacity:0;transform:translateX(-12px)"><span class="text-foreground text-[22px] leading-none font-medium tracking-tight sm:text-[26px]">Product</span><span class="bg-border/70 hidden h-px flex-1 sm:block"></span><span class="text-muted-foreground/45 shrink-0 font-mono text-[10.5px] whitespace-nowrap">a document</span></li><li class="flex items-baseline gap-4 py-[0.42rem]" style="padding-left:10.8%;opacity:0;transform:translateX(-12px)"><span class="text-foreground text-[22px] leading-none font-medium tracking-tight sm:text-[26px]">Engineering</span><span class="bg-border/70 hidden h-px flex-1 sm:block"></span><span class="text-muted-foreground/45 shrink-0 font-mono text-[10.5px] whitespace-nowrap">a patch</span></li><li class="flex items-baseline gap-4 py-[0.42rem]" style="padding-left:12.4%;opacity:0;transform:translateX(-12px)"><span class="text-foreground text-[22px] leading-none font-medium tracking-tight sm:text-[26px]">Finance</span><span class="bg-border/70 hidden h-px flex-1 sm:block"></span><span class="text-muted-foreground/45 shrink-0 font-mono text-[10.5px] whitespace-nowrap">a table</span></li><li class="flex items-baseline gap-4 py-[0.42rem]" style="padding-left:14%;opacity:0;transform:translateX(-12px)"><span class="text-foreground text-[22px] leading-none font-medium tracking-tight sm:text-[26px]">People</span><span class="bg-border/70 hidden h-px flex-1 sm:block"></span><span class="text-muted-foreground/45 shrink-0 font-mono text-[10.5px] whitespace-nowrap">a document</span></li><li class="flex items-baseline gap-4 py-[0.42rem]" style="padding-left:15.600000000000001%;opacity:0;transform:translateX(-12px)"><span class="text-foreground text-[22px] leading-none font-medium tracking-tight sm:text-[26px]">IT</span><span class="bg-border/70 hidden h-px flex-1 sm:block"></span><span class="text-muted-foreground/45 shrink-0 font-mono text-[10.5px] whitespace-nowrap">a table</span></li><li class="flex items-baseline gap-4 py-[0.42rem]" style="padding-left:17.200000000000003%;opacity:0;transform:translateX(-12px)"><span class="text-foreground text-[22px] leading-none font-medium tracking-tight sm:text-[26px]">Data Science</span><span class="bg-border/70 hidden h-px flex-1 sm:block"></span><span class="text-muted-foreground/45 shrink-0 font-mono text-[10.5px] whitespace-nowrap">a query</span></li></ul></div></div></div></div></section><section id="roles" class="mx-auto max-w-7xl px-6 py-24 sm:py-30"><div class="" style="opacity:0;filter:blur(8px);transform:translateY(30px)"><div class="flex w-full flex-col gap-4 select-none"><span class="text-muted-foreground font-mono text-[0.75rem] leading-none font-normal uppercase select-none" data-text="true">By role</span><h2 data-heading="true" class="text-foreground max-w-2xl font-sans text-2xl font-medium text-balance sm:text-3xl">Start with the work, not the platform.</h2></div><p class="text-muted-foreground mt-4 max-w-2xl text-base leading-relaxed">Every page below is written about that team&#x27;s actual week — what it can hand off, which connectors make sense for it, and what the output looks like when it comes back.</p></div><div class="" style="opacity:0;filter:blur(8px);transform:translateY(30px)"><ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><li><a class="border-border bg-card hover:bg-accent/40 flex h-full flex-col rounded-sm border p-6 transition-colors" href="/solutions/sales"><span class="text-muted-foreground font-mono text-[10px] tracking-widest uppercase">01</span><span class="text-foreground mt-3 text-lg leading-tight font-medium">Sales</span><span class="text-muted-foreground mt-2.5 text-sm leading-relaxed">Research, drafts and CRM hygiene, held for your approval</span><span class="text-muted-foreground mt-auto pt-6 font-mono text-[10px] tracking-widest uppercase">Read →</span></a></li><li><a class="border-border bg-card hover:bg-accent/40 flex h-full flex-col rounded-sm border p-6 transition-colors" href="/solutions/marketing"><span class="text-muted-foreground font-mono text-[10px] tracking-widest uppercase">02</span><span class="text-foreground mt-3 text-lg leading-tight font-medium">Marketing</span><span class="text-muted-foreground mt-2.5 text-sm leading-relaxed">Production work that sounds like you, because the voice is a file</span><span class="text-muted-foreground mt-auto pt-6 font-mono text-[10px] tracking-widest uppercase">Read →</span></a></li><li><a class="border-border bg-card hover:bg-accent/40 flex h-full flex-col rounded-sm border p-6 transition-colors" href="/solutions/product"><span class="text-muted-foreground font-mono text-[10px] tracking-widest uppercase">03</span><span class="text-foreground mt-3 text-lg leading-tight font-medium">Product</span><span class="text-muted-foreground mt-2.5 text-sm leading-relaxed">Feedback synthesised into specs, with the evidence attached</span><span class="text-muted-foreground mt-auto pt-6 font-mono text-[10px] tracking-widest uppercase">Read →</span></a></li><li><a class="border-border bg-card hover:bg-accent/40 flex h-full flex-col rounded-sm border p-6 transition-colors" href="/solutions/engineering"><span class="text-muted-foreground font-mono text-[10px] tracking-widest uppercase">04</span><span class="text-foreground mt-3 text-lg leading-tight font-medium">Engineering</span><span class="text-muted-foreground mt-2.5 text-sm leading-relaxed">Reproduce it, patch it, open the change request</span><span class="text-muted-foreground mt-auto pt-6 font-mono text-[10px] tracking-widest uppercase">Read →</span></a></li><li><a class="border-border bg-card hover:bg-accent/40 flex h-full flex-col rounded-sm border p-6 transition-colors" href="/solutions/finance"><span class="text-muted-foreground font-mono text-[10px] tracking-widest uppercase">05</span><span class="text-foreground mt-3 text-lg leading-tight font-medium">Finance</span><span class="text-muted-foreground mt-2.5 text-sm leading-relaxed">The close, the reconciliation and the variance note</span><span class="text-muted-foreground mt-auto pt-6 font-mono text-[10px] tracking-widest uppercase">Read →</span></a></li><li><a class="border-border bg-card hover:bg-accent/40 flex h-full flex-col rounded-sm border p-6 transition-colors" href="/solutions/people"><span class="text-muted-foreground font-mono text-[10px] tracking-widest uppercase">06</span><span class="text-foreground mt-3 text-lg leading-tight font-medium">People</span><span class="text-muted-foreground mt-2.5 text-sm leading-relaxed">Scheduling, kits and onboarding — never the hiring decision</span><span class="text-muted-foreground mt-auto pt-6 font-mono text-[10px] tracking-widest uppercase">Read →</span></a></li><li><a class="border-border bg-card hover:bg-accent/40 flex h-full flex-col rounded-sm border p-6 transition-colors" href="/solutions/it"><span class="text-muted-foreground font-mono text-[10px] tracking-widest uppercase">07</span><span class="text-foreground mt-3 text-lg leading-tight font-medium">IT</span><span class="text-muted-foreground mt-2.5 text-sm leading-relaxed">Runbooks that execute, and a platform that survives your review</span><span class="text-muted-foreground mt-auto pt-6 font-mono text-[10px] tracking-widest uppercase">Read →</span></a></li><li><a class="border-border bg-card hover:bg-accent/40 flex h-full flex-col rounded-sm border p-6 transition-colors" href="/solutions/data-science"><span class="text-muted-foreground font-mono text-[10px] tracking-widest uppercase">08</span><span class="text-foreground mt-3 text-lg leading-tight font-medium">Data Science</span><span class="text-muted-foreground mt-2.5 text-sm leading-relaxed">A real machine, a real query, an analysis you can re-run</span><span class="text-muted-foreground mt-auto pt-6 font-mono text-[10px] tracking-widest uppercase">Read →</span></a></li></ul></div></section><div class="mx-auto max-w-7xl px-6"><div data-orientation="horizontal" role="none" data-slot="separator" class="bg-border shrink-0 data-[orientation=horizontal]:h-px data-[orientation=horizontal]:w-full data-[orientation=vertical]:h-full data-[orientation=vertical]:w-px"></div></div><section id="constant" class="mx-auto max-w-7xl px-6 py-24 sm:py-30"><div class="" style="opacity:0;filter:blur(8px);transform:translateY(30px)"><div class="flex w-full flex-col gap-4 select-none"><span class="text-muted-foreground font-mono text-[0.75rem] leading-none font-normal uppercase select-none" data-text="true">What never changes</span><h2 data-heading="true" class="text-foreground max-w-2xl font-sans text-2xl font-medium text-balance sm:text-3xl">Eight kinds of work. One set of rules underneath.</h2></div><p class="text-muted-foreground mt-4 max-w-2xl text-base leading-relaxed">The pages differ because the work differs. What sits under all of them is identical, and it is worth reading once rather than eight times.</p></div><div class="" style="opacity:0;filter:blur(8px);transform:translateY(30px)"><div class="mt-10"><dl class="border-border bg-card overflow-hidden rounded-sm border"><div class="border-border grid gap-2 px-6 py-6 sm:grid-cols-12 sm:gap-8 sm:px-8 sm:py-7"><dt class="text-foreground font-mono text-[11px] tracking-widest uppercase sm:col-span-4">A session is a machine</dt><dd class="text-muted-foreground text-sm leading-relaxed sm:col-span-8">Every session boots its own disposable Linux computer and cuts its own branch. Thousands can run in parallel on one configuration without touching each other. The machine is real: the agent has a shell, a filesystem and the network.</dd></div><div class="border-border grid gap-2 px-6 py-6 sm:grid-cols-12 sm:gap-8 sm:px-8 sm:py-7 border-t"><dt class="text-foreground font-mono text-[11px] tracking-widest uppercase sm:col-span-4">Work lands through a change request</dt><dd class="text-muted-foreground text-sm leading-relaxed sm:col-span-8">What an agent means to keep is committed on the session branch and proposed back toward main. Merge is default-deny for agents; an admin can grant project.cr.merge in kortix.yaml, and widening that grant is itself a reviewed change.</dd></div><div class="border-border grid gap-2 px-6 py-6 sm:grid-cols-12 sm:gap-8 sm:px-8 sm:py-7 border-t"><dt class="text-foreground font-mono text-[11px] tracking-widest uppercase sm:col-span-4">Approval gates are off until you set them</dt><dd class="text-muted-foreground text-sm leading-relaxed sm:col-span-8">The shipped default is permissive — an action runs unless you have said otherwise. Set Ask on what should pause and Block on what should never happen, per action or with a pattern rule that can read the arguments in the call.</dd></div><div class="border-border grid gap-2 px-6 py-6 sm:grid-cols-12 sm:gap-8 sm:px-8 sm:py-7 border-t"><dt class="text-foreground font-mono text-[11px] tracking-widest uppercase sm:col-span-4">Connector credentials never enter the machine</dt><dd class="text-muted-foreground text-sm leading-relaxed sm:col-span-8">The sandbox carries one project-scoped Kortix token and no third-party keys. The real credential is decrypted server-side and attached to the outbound call. A runtime secret you deliberately grant is different: it is a real environment value the agent can read.</dd></div><div class="border-border grid gap-2 px-6 py-6 sm:grid-cols-12 sm:gap-8 sm:px-8 sm:py-7 border-t"><dt class="text-foreground font-mono text-[11px] tracking-widest uppercase sm:col-span-4">Everything is a file you own</dt><dd class="text-muted-foreground text-sm leading-relaxed sm:col-span-8">Agents, skills, connectors, triggers and memory are text in a git repo. You can read the whole company, diff what changed, and revert it. Open source and self-hostable — Kortix Cloud, your own VPC, or your own on-prem network.</dd></div></dl></div></div><div class="" style="opacity:0;filter:blur(8px);transform:translateY(30px)"><div class="mt-6 flex flex-wrap gap-3"><a data-slot="button" class="group/button inline-flex shrink-0 cursor-pointer items-center justify-center gap-2 font-medium whitespace-nowrap transition-transform focus-visible:ring-1 focus-visible:outline-none active:scale-[0.98] disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none text-center [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 [&amp;_svg]:shrink-0 [&amp;_svg]:drop-shadow-sm dark:shadow-md shadow-black/15 border-[0.5px] border-foreground/10 bg-secondary text-secondary-foreground hover:bg-secondary/80 h-10 px-4 text-md rounded-[calc(var(--radius-md)-0.4px)]" href="/agent-computer">The agent computer</a><a data-slot="button" class="group/button inline-flex shrink-0 cursor-pointer items-center justify-center gap-2 font-medium whitespace-nowrap transition-transform focus-visible:ring-1 focus-visible:outline-none active:scale-[0.98] disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none text-center [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 [&amp;_svg]:shrink-0 [&amp;_svg]:drop-shadow-sm dark:shadow-md shadow-black/15 border-[0.5px] border-foreground/10 bg-secondary text-secondary-foreground hover:bg-secondary/80 h-10 px-4 text-md rounded-[calc(var(--radius-md)-0.4px)]" href="/connectors">Connectors</a><a data-slot="button" class="group/button inline-flex shrink-0 cursor-pointer items-center justify-center gap-2 font-medium whitespace-nowrap transition-transform focus-visible:ring-1 focus-visible:outline-none active:scale-[0.98] disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none text-center [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 [&amp;_svg]:shrink-0 [&amp;_svg]:drop-shadow-sm dark:shadow-md shadow-black/15 border-[0.5px] border-foreground/10 bg-secondary text-secondary-foreground hover:bg-secondary/80 h-10 px-4 text-md rounded-[calc(var(--radius-md)-0.4px)]" href="/security">Security</a></div></div></section></div>"`;
