{
  "buildCommand": "NODE_OPTIONS=--max-old-space-size=3584 next build",
  "installCommand": "pnpm install --frozen-lockfile",
  "regions": ["lhr1"],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "staging": true,
      "prod": false
    }
  }
}
